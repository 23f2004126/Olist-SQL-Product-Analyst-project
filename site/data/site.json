            "source": {
              "file": "results/13_handover_concentration.csv",
              "column": "pct_of_scorecard_late_handovers",
              "where": {}
            }
          }
        },
        "text": "62 sellers account for 55.42% of scorecard late handovers, so a handover standard can start with a small group."
      },
      "recommendation": "R2"
    },
    {
      "id": "F5",
      "title": "Growth came from volume, not bigger baskets",
      "cards": [
        "revenue_change",
        "orders_change",
