  "chapters": [
    {
      "id": "F1",
      "title": "Customers buy once",
      "cards": [
        "repeat_later_day",
        "same_day_share",
        "median_days_to_second",
        "repeat_revenue_share"
      ],
      "charts": [
        "repeat_units",
        "cohort_matrix"
      ],
      "why": {
        "text_template": "Second and later orders bring in only {share} of revenue, so bringing past buyers back is largely untapped.",
        "numbers": {
          "share": {
            "label": "Revenue from second and later orders",
            "value": 2.89,
            "display": "2.89%",
            "unit": "pct",
            "source": {
              "file": "results/10_repeat_revenue.csv",
              "column": "repeat_order_revenue_pct",
              "where": {}
            }
          }
        },
        "text": "Second and later orders bring in only 2.89% of revenue, so bringing past buyers back is largely untapped."
      },
      "recommendation": "R3"
    },
    {
      "id": "F2",
      "title": "Generous promises, late handovers",
      "cards": [
        "on_time",
        "early_7plus",
        "late_after_limit",
        "late_on_time_handover"
      ],
      "charts": [
        "delay_buckets",
        "stage_medians"
      ],
      "why": {
        "text_template": "Orders handed over after the seller's deadline run late {late} of the time against {ontime}, and handover is the step sellers control.",
        "numbers": {
          "late": {
            "label": "Late rate, handed over after the limit",
            "value": 21.1,
            "display": "21.10%",
            "unit": "pct",
            "source": {
              "file": "results/11_seller_handling.csv",
              "column": "late_rate_pct",
              "where": {
                "handover": "after limit"
              }
            }
          },
          "ontime": {
            "label": "Late rate, handed over on time",
            "value": 5.39,
            "display": "5.39%",
            "unit": "pct",
            "source": {
              "file": "results/11_seller_handling.csv",
              "column": "late_rate_pct",
              "where": {
                "handover": "on or before limit"
              }
            }
          }
        },
        "text": "Orders handed over after the seller's deadline run late 21.10% of the time against 5.39%, and handover is the step sellers control."
      },
      "recommendation": "R2"
    },
    {
      "id": "F3",
      "title": "Reviews written while waiting",
      "cards": [
        "low_7plus_early",
        "low_8plus_late",
        "late_reviewed_before",
        "late_share_of_low"
      ],
      "charts": [
        "low_by_delay",
        "late_review_timing"
      ],
      "why": {
        "text_template": "{before} of late orders are rated before they arrive, so many low scores are given while the parcel is still on its way.",
        "numbers": {
          "before": {
            "label": "Late orders reviewed before delivery",
            "value": 74.46,
            "display": "74.46%",
            "unit": "pct",
            "source": {
              "file": "results/12_review_timing.csv",
              "column": "pct_within_delivery_group",
              "where": {
                "delivery_group": "late",
                "review_timing": "before delivery"
              }
            }
          }
        },
        "text": "74.46% of late orders are rated before they arrive, so many low scores are given while the parcel is still on its way."
      },
      "recommendation": "R1"
    },
    {
      "id": "F4",
      "title": "A few sellers carry the marketplace",
      "cards": [
        "top1_share",
        "top20_share",
        "handover_top_share",
        "problem_low_share"
      ],
      "charts": [
        "seller_curve"
      ],
      "why": {
